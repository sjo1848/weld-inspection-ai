{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "weld-inspection-ai",
  "compatibility_date": "2026-09-19",
  "main": "./worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/assets/*.wasm"]
  },
  "r2_buckets": [
    {
      "binding": "RUNTIME_BUCKET",
      "bucket_name": "weld-vision-runtime"
    }
  ]
}
