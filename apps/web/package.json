{
  "name": "@weld-inspection-ai/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test:portability": "playwright test",
    "test:promoted": "playwright test tests/promoted-portability.spec.ts --config=playwright.promoted.config.ts",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "onnxruntime-web": "^1.20.1",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "^5.7.2",
    "vite": "^6.1.0",
    "vue-tsc": "^2.2.0",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^26.1.0",
    "vitest": "^3.2.4"
  }
}
